---
import { site } from '../data/site';

interface Props {
  /** Subtle footer subscribe — homepage and non-blog pages only. */
  showSubscribe?: boolean;
}

const { showSubscribe = false } = Astro.props;
const year = new Date().getFullYear();
const subscribeAction = 'https://api.gokhan.vc/newsletter/subscribe';
---

<footer class="site-footer">
  <div class="dither-divider" aria-hidden="true"></div>
  <div class="site-footer-inner">
    {
      showSubscribe && (
        <div class="footer-subscribe" aria-labelledby="footer-subscribe-heading" data-xmtp-root>
          <form class="foot-sub-form" method="POST" action={subscribeAction}>
            <p class="footer-subscribe-copy" id="footer-subscribe-heading">
              Dispatches — occasional, low-frequency. <a href="/feed.xml">RSS</a> ·{' '}
              <a href="https://api.gokhan.vc/feed.xml">all sites</a>
            </p>
            <div class="foot-sub-row foot-sub-row--footer">
              <input
                type="email"
                name="email"
                required
                placeholder="you@email.com"
                autocomplete="email"
                aria-label="Email"
                class="foot-sub-input foot-sub-input--footer"
              />
              <input type="hidden" name="site" value="atelier" />
              <div class="foot-sub-actions">
                <button type="submit" class="foot-sub-btn foot-sub-btn--footer">
                  Subscribe
                </button>
                <button
                  type="button"
                  class="foot-sub-btn foot-sub-btn--footer foot-sub-btn--xmtp"
                  data-xmtp-btn
                  data-xmtp-site="atelier"
                >
                  Connect wallet (XMTP)
                </button>
              </div>
            </div>
          </form>
          <p
            class="foot-sub-status foot-sub-status--footer"
            data-xmtp-status
            role="status"
            aria-live="polite"
          />
        </div>
      )
    }
    <nav class="footer-nav" aria-label="Site">
      <ul class="footer-links">
        <li><a href="/blog">Blog</a></li>
        <li><a href="/llms.txt">LLM sitemap (llms.txt)</a></li>
        <li><a href="https://status.numetal.xyz">Status</a></li>
        <li><a href="/terms">Terms</a></li>
        <li><a href="/privacy">Privacy</a></li>
        <li><a href="/cookies">Cookies</a></li>
        <li>
          <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
        </li>
      </ul>
    </nav>
    <p class="copyright">© {year} {site.name}</p>
    <p class="colophon">
      <span>Atelier Gökhan Turhan · gokhan.vc · Rev 2026-07-18</span>
      <span>Filed as public record — monochrome, monospace</span>
    </p>
  </div>
</footer>

{showSubscribe && <script src="/newsletter-xmtp.js" defer />}

<style>
  .site-footer {
    background: var(--paper);
    color: var(--ink);
    font-size: 13px;
  }
  .site-footer-inner {
    padding: var(--space-4);
  }
  .footer-subscribe {
    margin: 0 0 var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--ink);
  }
  .footer-subscribe-copy {
    margin: 0 0 var(--space-2);
    font-size: 13px;
    color: var(--dim);
    line-height: 1.45;
  }
  .footer-subscribe-copy a {
    color: var(--ink);
    text-decoration: underline;
  }
  .footer-nav {
    margin: 0 0 var(--space-2) 0;
  }
  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .footer-links a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .copyright {
    margin: 0 0 var(--space-3);
    color: var(--dim);
  }
</style>
