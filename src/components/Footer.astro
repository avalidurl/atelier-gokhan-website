---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="dither-divider" aria-hidden="true"></div>
  <div class="site-footer-inner">
    <section class="footer-subscribe" aria-labelledby="subscribe-heading">
      <p class="subscribe-heading" id="subscribe-heading">Newsletter</p>
      <form
        method="POST"
        action="https://api.gokhan.vc/newsletter/subscribe"
        style="display:flex;gap:8px;flex-wrap:wrap;max-width:420px;margin:1rem 0"
      >
        <input
          type="email"
          name="email"
          required
          placeholder="you@email.com"
          autocomplete="email"
          aria-label="Email"
          style="flex:1;min-width:200px;padding:10px 12px;border:1px solid currentColor;background:transparent;color:inherit;font:inherit"
        />
        <input type="hidden" name="site" value="atelier" />
        <button
          type="submit"
          style="padding:10px 18px;border:1px solid currentColor;background:currentColor;color:Canvas;font:inherit;cursor:pointer"
          >Subscribe</button
        >
      </form>
    </section>
    <nav class="footer-nav" aria-label="Site">
      <ul class="footer-links">
        <li><a href="/blog">Blog</a></li>
        <li><a href="/terms">Terms</a></li>
        <li><a href="/privacy">Privacy</a></li>
        <li><a href="/cookies">Cookies</a></li>
        <li>
          <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
        </li>
      </ul>
    </nav>
    <p class="copyright">© {year} {site.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg);
    color: var(--ink);
    font-size: 14px;
  }
  .site-footer-inner {
    padding: var(--space-4);
  }
  .footer-subscribe {
    margin: 0 0 var(--space-3) 0;
  }
  .subscribe-heading {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0;
  }
  .footer-nav {
    margin: 0 0 var(--space-2) 0;
  }
  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .footer-links a {
    color: var(--accent-purple);
    text-decoration: none;
  }
  .footer-links a:hover,
  .footer-links a:focus-visible {
    text-decoration: underline;
  }
  .copyright {
    margin: 0;
    color: var(--muted);
  }
</style>
