---
import { site } from '../data/site';
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label={`${site.name} — home`}>
    <span class="wordmark-text">{site.name}</span>
  </a>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 24px;
    border-bottom: 1px solid #cdcdcd;
    background: #fff;
  }
  .wordmark {
    color: #141414;
    text-decoration: none;
    font-weight: 700;
    letter-spacing: 0.01em;
    font-size: 18px;
  }
  .wordmark:hover,
  .wordmark:focus-visible {
    color: #8466c4;
  }
  .wordmark:focus-visible {
    outline: 2px solid #8466c4;
    outline-offset: 4px;
  }
  .wordmark-text {
    display: inline-block;
  }
</style>
