---
import { site } from '../data/site';
---

<header class="site-header">
  <a class="wordmark tile" href="/" aria-label={`${site.name} — home`}>
    <span class="wordmark-dot" aria-hidden="true"></span>
    <span class="wordmark-text">{site.name}</span>
  </a>
  <nav class="main-nav" aria-label="Main navigation">
    <a href="/blog/">Blog</a>
    <a href="https://ishtar.numetal.xyz" target="_blank" rel="noopener noreferrer">Ishtar<span class="nav-live" aria-hidden="true">live</span><span class="nav-ext" aria-hidden="true">↗</span></a>
    <a href="https://numetal.xyz" target="_blank" rel="noopener noreferrer">Numetal Lab<span class="nav-ext" aria-hidden="true">↗</span></a>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: var(--space-4);
    background: var(--bg);
    border-bottom: 1px solid var(--hard);
  }
  .wordmark {
    color: var(--accent-purple);
    font-size: 16px;
    letter-spacing: 0.02em;
    line-height: 1;
  }
  .wordmark-dot {
    width: 10px;
    height: 10px;
    border-radius: var(--radius-pill);
    background: var(--accent-purple);
    box-shadow:
      0 0 0 2px var(--paper),
      0 0 0 3px var(--ink);
    flex: none;
  }
  .wordmark-text {
    white-space: nowrap;
  }
  @media (max-width: 480px) {
    .site-header {
      padding: var(--space-3);
    }
    .wordmark {
      font-size: 14px;
    }
  }

  .main-nav {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
  }
  .main-nav a {
    color: var(--muted-foreground);
    text-decoration: none;
    transition: color 0.1s ease;
  }
  .main-nav a:hover,
  .main-nav a:focus-visible {
    color: var(--foreground);
  }
  .nav-ext {
    font-size: 0.8em;
    opacity: 0.6;
    margin-left: 2px;
  }
  .nav-live {
    font-size: 0.65em;
    background: var(--accent-purple);
    color: var(--background);
    padding: 0 3px;
    border-radius: 2px;
    margin-left: 2px;
    vertical-align: middle;
  }

  @media (max-width: 768px) {
    .main-nav {
      display: none;
    }
  }
</style>
