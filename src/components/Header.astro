---
import { site } from '../data/site';
---

<header class="site-header">
  <a class="wordmark tile" href="/" aria-label={`${site.name} — home`}>
    <span class="wordmark-text">{site.name}</span>
  </a>
  <nav class="main-nav" aria-label="Main navigation">
    <a href="/blog/">Blog</a>
    <a href="https://ishtar.numetal.xyz" target="_blank" rel="noopener noreferrer"
      >Ishtar<span class="nav-live" aria-hidden="true">flagship</span><span
        class="nav-ext"
        aria-hidden="true">↗</span
      ></a
    >
    <a href="https://curb.numetal.xyz" target="_blank" rel="noopener noreferrer"
      >Curb<span class="nav-ext" aria-hidden="true">↗</span></a
    >
    <a href="https://numetal.xyz" target="_blank" rel="noopener noreferrer"
      >Numetal Lab<span class="nav-ext" aria-hidden="true">↗</span></a
    >
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: var(--space-4);
    background: var(--paper);
    border-bottom: 1px solid var(--ink);
  }
  .wordmark {
    /* R1 — wordmark. Overrides the R4 face .tile sets for button labels. */
    font-family: var(--font-text);
    color: var(--ink);
    font-size: 15px;
    letter-spacing: 0.02em;
    line-height: 1;
  }
  .wordmark-text {
    white-space: nowrap;
  }
  @media (max-width: 480px) {
    .site-header {
      padding: var(--space-3);
    }
    .wordmark {
      font-size: 13px;
    }
  }

  .main-nav {
    /* R4 — nav labels. */
    font-family: var(--font-data);
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
  }
  .main-nav a {
    color: var(--ink);
    text-decoration: none;
  }
  .main-nav a:hover,
  .main-nav a:focus-visible {
    text-decoration: underline;
  }
  .nav-ext {
    font-size: 0.8em;
    color: var(--dim);
    margin-left: 2px;
  }
  /* The chip survives; the claim inside it changed. It used to read "live",
     which was the fourth restatement of the ticker's LIVE tag on the same
     screen and was bound to nothing — gokhan.vc has no liveness feed of its
     own. "flagship" is a studio-level fact about the portfolio, which is the
     only kind of claim this nav is in a position to make. */
  .nav-live {
    font-size: 0.65em;
    border: 1px solid var(--ink);
    color: var(--ink);
    padding: 0 3px;
    margin-left: 3px;
    vertical-align: middle;
    letter-spacing: 0.14em;
  }

  @media (max-width: 768px) {
    .main-nav {
      display: none;
    }
  }
</style>
