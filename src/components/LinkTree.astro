---
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { properties } from '../data/links';
import type { LinkProperty } from '../data/links';

/** Content hash of the popup script, so an edit busts the 4h asset cache for every
 *  visitor. The HTML is served max-age=0, so a changed ?v= always lands immediately.
 *  Resolved from the project root — import.meta.url points into the build output. */
const popupsVersion = createHash('sha256')
  .update(readFileSync(resolve(process.cwd(), 'public/link-popups.js')))
  .digest('hex')
  .slice(0, 8);

function leafAttrs(leaf: { href: string; external: boolean; tooltip: string }) {
  return {
    'data-tip': leaf.tooltip,
    ...(leaf.external ? { target: '_blank', rel: 'noopener noreferrer' } : {}),
  };
}

function leafCount(property: LinkProperty): number {
  return (
    property.apiTools.length +
    1 +
    (property.blog ? 1 : 0) +
    (property.docs ? 1 : 0) +
    property.socials.length +
    property.contacts.length
  );
}
---

<section class="tree-section" aria-labelledby="pedigree-title">
  <p class="tree-stamp doc-heading" id="pedigree-title">
    <span>Portfolio · six tiles, one studio</span><span class="section-no" aria-hidden="true"
      >§1</span
    >
  </p>

  <div class="kanban-board" role="list">
    {
      properties.map((property, index) => (
        <article class="kanban-col" role="listitem">
          <details class="board-details sheet">
            <summary class="board-header" id={`board-${property.id}`}>
              <span class="board-meta" aria-hidden="true">
                <span class="board-index">{String(index + 1).padStart(2, '0')}</span>
                <span class="board-count">{leafCount(property)} links</span>
              </span>
              <span class="board-summary">
                <span class="board-label">{property.label}</span>
                <span class="board-domain">{property.domain}</span>
                <span class="board-owner">{property.owner}</span>
              </span>
              <span class="board-toggle" aria-hidden="true">
                <span class="board-toggle-open">Open</span>
                <span class="board-toggle-close">Close</span>
              </span>
            </summary>
            <div class="board-body" aria-labelledby={`board-${property.id}`}>
              <ul class="leaves" role="list">
                {property.apiTools.map((leaf) => (
                  <li class="leaf">
                    <a class="leaf-link" href={leaf.href} {...leafAttrs(leaf)}>
                      <span class="leaf-platform">{leaf.platform}</span>
                      <span class="leaf-note">{leaf.note}</span>
                    </a>
                  </li>
                ))}
                <li class="leaf">
                  <a
                    class="leaf-link"
                    href={property.website.href}
                    {...leafAttrs(property.website)}
                  >
                    <span class="leaf-platform">{property.website.platform}</span>
                    <span class="leaf-note">{property.website.note}</span>
                  </a>
                </li>
                {property.blog && (
                  <li class="leaf">
                    <a class="leaf-link" href={property.blog.href} {...leafAttrs(property.blog)}>
                      <span class="leaf-platform">{property.blog.platform}</span>
                      <span class="leaf-note">{property.blog.note}</span>
                    </a>
                  </li>
                )}
                {property.docs && (
                  <li class="leaf">
                    <a class="leaf-link" href={property.docs.href} {...leafAttrs(property.docs)}>
                      <span class="leaf-platform">{property.docs.platform}</span>
                      <span class="leaf-note">{property.docs.note}</span>
                    </a>
                  </li>
                )}
                {property.socials.length > 0 && (
                  <li class="leaf-heading" aria-hidden="false">
                    <h3 class="socials-heading">Socials</h3>
                  </li>
                )}
                {property.socials.map((leaf) => (
                  <li class="leaf">
                    <a class="leaf-link" href={leaf.href} {...leafAttrs(leaf)}>
                      <span class="leaf-platform">{leaf.platform}</span>
                      <span class="leaf-note">{leaf.note}</span>
                    </a>
                  </li>
                ))}
                {property.contacts.map((leaf) => (
                  <li class="leaf leaf-contact">
                    <a class="leaf-link" href={leaf.href} {...leafAttrs(leaf)}>
                      <span class="leaf-platform">{leaf.platform}</span>
                      <span class="leaf-note">{leaf.note}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </details>
        </article>
      ))
    }
  </div>
</section>

<script src={`/link-popups.js?v=${popupsVersion}`} defer></script>

<style>
  .tree-section {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 var(--space-3) var(--space-7);
  }

  .tree-stamp {
    margin: 0 0 var(--space-5);
  }

  .kanban-board {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    align-items: start;
  }

  @media (min-width: 640px) {
    .kanban-board {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .kanban-board {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .kanban-col {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .board-details {
    margin: 0;
    padding: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .board-header {
    position: relative;
    margin: 0;
    padding: var(--space-3);
    font-size: 16px;
    list-style: none;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-2);
  }

  .board-details[open] > .board-header {
    border-bottom: 2px solid var(--ink);
  }

  .board-header::-webkit-details-marker,
  .board-header::marker {
    display: none;
  }

  .board-meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .board-index {
    color: var(--ink);
    font-weight: 700;
  }

  .board-count {
    color: var(--muted);
  }

  .board-toggle {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .board-toggle-close {
    display: none;
  }

  .board-details[open] > .board-header .board-toggle-open {
    display: none;
  }

  .board-details[open] > .board-header .board-toggle-close {
    display: inline;
  }

  .board-summary {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 0;
    flex: 0 0 auto;
    min-width: 0;
  }

  .board-header:hover {
    background: var(--faint);
  }

  .board-header:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  .board-label {
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--ink);
    overflow-wrap: anywhere;
    font-size: 21px;
  }

  .board-domain {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--ink);
  }

  .board-owner {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.03em;
    color: var(--muted);
    line-height: 1.5;
    /* reserve two lines so collapsed faces stay equal across the row */
    min-height: 3em;
  }

  .board-body {
    padding: 0 var(--space-3) var(--space-3);
    flex: 1;
  }

  .leaves {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0 0 0 var(--space-2);
    position: relative;
    border-left: 2px solid var(--hard);
  }

  .leaf {
    position: relative;
    padding: var(--space-1) 0 var(--space-1) 20px;
  }

  .leaf::before {
    content: '';
    position: absolute;
    left: -2px;
    top: 50%;
    width: 14px;
    border-top: 2px solid var(--hard);
  }

  .leaf-heading {
    list-style: none;
    padding: var(--space-3) 0 var(--space-1) 20px;
    position: relative;
  }

  .leaf-heading::before {
    content: '';
    position: absolute;
    left: -2px;
    top: 50%;
    width: 14px;
    border-top: 2px solid var(--hard);
  }

  .socials-heading {
    margin: 0;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .leaf-contact {
    margin-top: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px dashed var(--line);
  }

  .leaf-contact::before {
    display: none;
  }

  .leaf-link {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1px;
    max-width: 100%;
    padding: 3px var(--space-2);
    border: 1px solid transparent;
    text-decoration: none;
  }

  .leaf-platform {
    font-weight: 700;
    font-size: 13px;
    color: var(--ink);
  }

  .leaf-note {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--dim);
    overflow-wrap: anywhere;
    line-height: 1.35;
  }

  .leaf-link:hover,
  .leaf-link:focus-visible {
    background: var(--paper);
    border-color: var(--ink);
  }

  .leaf-link:hover .leaf-platform,
  .leaf-link:focus-visible .leaf-platform {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .leaf-link:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  @media (max-width: 480px) {
    .tree-section {
      padding-bottom: var(--space-6);
    }
  }
</style>
