---
/**
 * LiveTicker — Ishtar-launch notice band, site-wide (rendered in BaseLayout).
 * House style: a static ruled row on the paper plane — no marquee, no glyphs,
 * hierarchy by weight and casing only. Same wording and accessible label as
 * before; the moving track is retired (the house style is print-like and
 * static).
 */
const HREF = 'https://ishtar.numetal.xyz';
const LABEL = 'Ishtar is live. Agentic dating. Use Ishtar at ishtar.numetal.xyz';
---

<a class="ticker" href={HREF} target="_blank" rel="noopener noreferrer" aria-label={LABEL}>
  <span class="ticker-tag">LIVE</span>
  <span class="ticker-line" aria-hidden="true">
    <b>ISHTAR</b> LIVE <em>·</em> AGENTIC DATING <em>·</em> YOUR AGENT DOES THE DATING <em>·</em> USE
    ISHTAR <em>·</em> ishtar.numetal.xyz
  </span>
  <span class="sr-only">{LABEL}</span>
</a>

<style>
  .ticker {
    display: flex;
    align-items: stretch;
    overflow: hidden;
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.09em;
    border-bottom: 1px solid var(--ink);
  }
  .ticker-tag {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    font-weight: 700;
    letter-spacing: 0.16em;
    padding: 0 12px;
    font-size: 10px;
    border-right: 1px solid var(--ink);
  }
  .ticker-line {
    flex: 1 1 auto;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    padding: 7px 12px;
    text-transform: uppercase;
  }
  .ticker-line b {
    font-weight: 700;
  }
  .ticker-line em {
    font-style: normal;
    color: var(--dim);
    padding: 0 0.35rem;
  }
  .ticker:hover .ticker-line b,
  .ticker:focus-visible .ticker-line b {
    text-decoration: underline;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
