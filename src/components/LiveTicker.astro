---
/**
 * LiveTicker — rolling live-product band, site-wide (rendered in BaseLayout).
 * One track, two filings: Ishtar on the paper plane, CURB on the faint fill —
 * the shade shift is what separates the two as the band rolls. Ink only,
 * no glyph decoration; hierarchy by weight, casing, and fill. 45s loop,
 * pauses on hover; static under prefers-reduced-motion.
 */
const ISHTAR_HREF = 'https://ishtar.numetal.xyz';
const ISHTAR_LABEL = 'Ishtar is live. Agentic dating. Use Ishtar at ishtar.numetal.xyz';
const CURB_HREF = 'https://curb.numetal.xyz';
const CURB_LABEL = 'Curb is live. Agent-to-agent inference swap. Use Curb at curb.numetal.xyz';
const LOOPS = [0, 1, 2, 3];
---

<div class="ticker" role="region" aria-label="Live product notices">
  <span class="ticker-tag">LIVE</span>
  <div class="ticker-win">
    <div class="ticker-track">
      {
        LOOPS.map((i) => (
          <Fragment>
            <a
              class="ticker-seg seg-ishtar"
              href={ISHTAR_HREF}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={ISHTAR_LABEL}
              {...(i > 0 ? { 'aria-hidden': 'true', tabindex: '-1' } : {})}
            >
              <b>ISHTAR</b> LIVE <em>·</em> AGENTIC DATING <em>·</em> YOUR AGENT DOES THE DATING{' '}
              <em>·</em> USE ISHTAR <em>·</em> ishtar.numetal.xyz
            </a>
            <a
              class="ticker-seg seg-curb"
              href={CURB_HREF}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={CURB_LABEL}
              {...(i > 0 ? { 'aria-hidden': 'true', tabindex: '-1' } : {})}
            >
              <b>CURB</b> LIVE <em>·</em> AGENT↔AGENT INFERENCE SWAP <em>·</em> YOUR AGENT TRADES
              THE MTOK <em>·</em> USE CURB <em>·</em> curb.numetal.xyz
            </a>
          </Fragment>
        ))
      }
    </div>
  </div>
</div>

<style>
  .ticker {
    display: flex;
    align-items: stretch;
    overflow: hidden;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.09em;
    border-bottom: 1px solid var(--ink);
  }
  .ticker-tag {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    font-weight: 700;
    letter-spacing: 0.16em;
    padding: 0 12px;
    font-size: 10px;
    border-right: 1px solid var(--ink);
    background: var(--paper);
    position: relative;
    z-index: 1;
  }
  .ticker-win {
    flex: 1 1 auto;
    overflow: hidden;
  }
  .ticker-track {
    display: flex;
    width: max-content;
    animation: ticker-roll 45s linear infinite;
  }
  .ticker-seg {
    flex: 0 0 auto;
    white-space: nowrap;
    padding: 7px 18px;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
  }
  /* The shade is the divider: CURB rides the faint fill, Ishtar the paper. */
  .seg-curb {
    background: var(--faint);
  }
  .ticker-seg b {
    font-weight: 700;
  }
  .ticker-seg em {
    font-style: normal;
    color: var(--dim);
    padding: 0 0.35rem;
  }
  .ticker-seg:hover b,
  .ticker-seg:focus-visible b {
    text-decoration: underline;
  }
  .ticker:hover .ticker-track,
  .ticker:focus-within .ticker-track {
    animation-play-state: paused;
  }
  @keyframes ticker-roll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-25%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker-track {
      animation: none;
    }
  }
</style>
