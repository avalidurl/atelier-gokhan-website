---
/**
 * LiveTicker — rolling Ishtar-launch band, site-wide (rendered in BaseLayout).
 * Same wording + phase (32s, translateX -25% over 4 segments) as numetal.xyz's
 * ticker, but strictly MONOCHROME per the house style: black bar, white text,
 * inverted white LIVE tag, separators/glyphs by opacity — never hue.
 * Pauses on hover; static under prefers-reduced-motion.
 */
const HREF = 'https://ishtar.numetal.xyz';
const LABEL = 'Ishtar is live. Agentic dating. Use Ishtar at ishtar.numetal.xyz';
---

<a class="ticker" href={HREF} target="_blank" rel="noopener noreferrer" aria-label={LABEL}>
  <span class="ticker-tag">● LIVE</span>
  <span class="ticker-win">
    <span class="ticker-track" aria-hidden="true">
      {
        [0, 1, 2, 3].map(() => (
          <span class="ticker-seg">
            <b>ISHTAR</b> <i class="up">▲</i> LIVE <em>◆</em> AGENTIC DATING <em>◆</em> YOUR AGENT DOES THE DATING <em>◆</em> USE ISHTAR <span class="hrt">♥</span> <em>◆</em> ishtar.numetal.xyz <em>◆</em>&nbsp;
          </span>
        ))
      }
    </span>
  </span>
  <span class="sr-only">{LABEL}</span>
</a>

<style>
  .ticker {
    display: flex;
    align-items: stretch;
    overflow: hidden;
    background: #141414;
    color: #fff;
    text-decoration: none;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 12px;
    letter-spacing: 0.06em;
    border-bottom: 1px solid var(--hard, #141414);
  }
  .ticker-tag {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 5px;
    background: #fff;
    color: #141414;
    font-weight: 700;
    letter-spacing: 0.16em;
    padding: 0 12px;
    font-size: 11px;
  }
  .ticker-win {
    flex: 1 1 auto;
    overflow: hidden;
  }
  .ticker-track {
    display: flex;
    width: max-content;
    padding: 7px 0;
    animation: ticker-roll 32s linear infinite;
  }
  .ticker-seg {
    flex: 0 0 auto;
    white-space: nowrap;
  }
  .ticker-seg b {
    font-weight: 700;
  }
  .ticker-seg .up {
    font-style: normal;
    font-size: 10px;
    opacity: 0.85;
  }
  .ticker-seg .hrt {
    opacity: 0.9;
  }
  .ticker-seg em {
    font-style: normal;
    opacity: 0.4;
    padding: 0 0.55rem;
  }
  .ticker:hover .ticker-track,
  .ticker:focus-visible .ticker-track {
    animation-play-state: paused;
  }
  @keyframes ticker-roll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-25%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker-track {
      animation: none;
    }
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
