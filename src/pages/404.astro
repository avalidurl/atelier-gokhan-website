---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const title = `Page not found — ${site.name}`;
---

<BaseLayout
  title={title}
  description="The page you were looking for does not exist."
  robots="noindex, follow"
>
  <section class="notfound">
    <div class="notfound-sheet sheet">
      <p class="notfound-code">404 <span class="stamp notfound-stamp">Not on file</span></p>
      <h1 class="notfound-title">Page not found</h1>
      <p class="notfound-body">
        That page doesn’t exist. It may have moved, or the link was mistyped.
      </p>
      <p class="notfound-actions">
        <a class="tile" href="/">← Back to home</a>
        <a class="tile" href="/blog">Blog</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    display: flex;
    justify-content: center;
    padding: var(--space-7) var(--space-3);
  }

  .notfound-sheet {
    width: 100%;
    max-width: 640px;
    padding: clamp(24px, 5vw, 48px);
  }

  .notfound-code {
    /* R4 — status code identifier. */
    font-family: var(--font-data);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--ink);
    margin: 0 0 var(--space-3);
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .notfound-stamp {
    font-weight: 700;
  }

  .notfound-title {
    margin: 0 0 var(--space-3);
    font-size: clamp(26px, 5.5vw, 44px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: 0.02em;
  }

  .notfound-body {
    margin: 0 0 var(--space-5);
    color: var(--ink);
    font-size: 14px;
  }

  .notfound-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
  }
</style>
