---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { isPublished, formatPostDate, isoDate } from '../../utils/blog';

// Static paths for published posts only — drafts get no route (→ 404).
export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter(isPublished);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const title = `${post.data.title} — ${site.name}`;
---

<BaseLayout
  title={title}
  description={post.data.description}
  canonical={post.data.canonicalUrl}
  ogImage={post.data.ogImage ?? '/og-image.png'}
  ogType="article"
>
  <article class="post">
    <a class="post-back" href="/blog">← Back to blog</a>
    <h1 class="post-title">{post.data.title}</h1>
    <p class="post-meta">
      <time datetime={isoDate(post.data.pubDate)}>{formatPostDate(post.data.pubDate)}</time>
      {
        post.data.updatedDate && (
          <>
            {' · Updated '}
            <time datetime={isoDate(post.data.updatedDate)}>
              {formatPostDate(post.data.updatedDate)}
            </time>
          </>
        )
      }
    </p>
    <div class="dither-divider" aria-hidden="true"></div>
    <div class="post-body">
      <Content />
    </div>
    <p class="post-back-foot"><a href="/blog">← Back to blog</a></p>
  </article>
</BaseLayout>

<style>
  .post {
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
    padding: var(--space-5) var(--space-4) var(--space-7);
  }

  .post-back,
  .post-back-foot a {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent-purple);
    text-decoration: none;
  }

  .post-back:hover,
  .post-back:focus-visible,
  .post-back-foot a:hover,
  .post-back-foot a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-title {
    margin: var(--space-4) 0 var(--space-2);
    font-size: clamp(28px, 5vw, 44px);
    line-height: 1.12;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .post-meta {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    margin: 0 0 var(--space-4);
  }

  .post-back-foot {
    margin-top: var(--space-6);
  }

  .post-body {
    font-size: 17px;
    line-height: 1.7;
  }

  .post-body :global(h2) {
    font-size: 24px;
    margin: var(--space-6) 0 var(--space-3);
    letter-spacing: -0.01em;
  }

  .post-body :global(h3) {
    font-size: 20px;
    margin: var(--space-5) 0 var(--space-2);
  }

  .post-body :global(p),
  .post-body :global(ul),
  .post-body :global(ol) {
    margin: 0 0 var(--space-4);
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    padding-left: var(--space-4);
  }

  .post-body :global(a) {
    color: var(--accent-purple);
  }

  .post-body :global(blockquote) {
    margin: 0 0 var(--space-4);
    padding: var(--space-2) var(--space-4);
    border-left: var(--border-hard);
    color: var(--muted);
  }

  .post-body :global(pre),
  .post-body :global(code) {
    font-family: var(--font-mono);
    font-size: 14px;
  }

  .post-body :global(pre) {
    background: var(--ink);
    color: var(--paper);
    padding: var(--space-3);
    overflow-x: auto;
  }

  .post-body :global(img) {
    max-width: 100%;
    height: auto;
  }
</style>
