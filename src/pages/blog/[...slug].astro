---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubscribeBlock from '../../components/SubscribeBlock.astro';
import { site } from '../../data/site';
import { isPublished, formatPostDate, isoDate } from '../../utils/blog';

// Static paths for published posts only — drafts get no route (→ 404).
export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter(isPublished);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const title = `${post.data.title} — ${site.name}`;

// Table of contents — section headings (h2/h3) only. The heading ids are set at
// build time by rehype-slug (see astro.config.mjs), so h.slug is the anchor.
// rehype-autolink-headings appends a "#" permalink into each heading, which
// leaks into h.text — strip that single trailing "#" for clean TOC labels.
const toc = headings
  .filter((h) => h.depth >= 2 && h.depth <= 3)
  .map((h) => ({ ...h, text: h.text.replace(/#$/, '').trimEnd() }));
---

<BaseLayout
  title={title}
  description={post.data.description}
  canonical={post.data.canonicalUrl}
  ogImage={post.data.ogImage ?? '/og-image.png'}
  ogType="article"
>
  <article class="post">
    <a class="post-back" href="/blog">← Back to blog</a>
    <h1 class="post-title">{post.data.title}</h1>
    <p class="post-meta">
      <time datetime={isoDate(post.data.pubDate)}>{formatPostDate(post.data.pubDate)}</time>
      {
        post.data.updatedDate && (
          <>
            {' · Updated '}
            <time datetime={isoDate(post.data.updatedDate)}>
              {formatPostDate(post.data.updatedDate)}
            </time>
          </>
        )
      }
    </p>
    {
      post.id === 'not-raising-a-preseed' && (
        <p class="deck-links">
          <a class="deck-pdf" href="https://ishtar.numetal.xyz/deck/not-raising-a-preseed/ishtar-deck-not-a-preseed.pdf" download>Download PDF</a>
          <a class="deck-view" href="https://ishtar.numetal.xyz/deck/not-raising-a-preseed/">View deck →</a>
          <a class="deck-md" href="https://ishtar.numetal.xyz/deck/not-raising-a-preseed/deck.md">deck.md</a>
        </p>
      )
    }
    <div class="dither-divider" aria-hidden="true"></div>
    {
      toc.length > 0 && (
        <details class="post-toc" open>
          <summary class="post-toc-label">Contents</summary>
          <ul>
            {toc.map((h) => (
              <li class:list={[`post-toc-d${h.depth}`]}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </details>
      )
    }
    <div class="post-body">
      <Content />
    </div>
    <p class="post-back-foot"><a href="/blog">← Back to blog</a></p>
  </article>
  <SubscribeBlock maxWidth="720px" />
</BaseLayout>

<style>
  .post {
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
    padding: var(--space-5) var(--space-4) var(--space-7);
  }

  .post-back,
  .post-back-foot a {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent-purple);
    text-decoration: none;
  }

  .post-back:hover,
  .post-back:focus-visible,
  .post-back-foot a:hover,
  .post-back-foot a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-title {
    margin: var(--space-4) 0 var(--space-2);
    font-size: clamp(28px, 5vw, 44px);
    line-height: 1.12;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .post-meta {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    margin: 0 0 var(--space-4);
  }

  .deck-links {
    margin: 0 0 var(--space-4);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem 0.75rem;
  }

  .deck-pdf {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    border: 2px solid var(--ink);
    padding: 0.45rem 0.85rem;
    background: var(--paper);
    font-weight: 700;
  }

  .deck-view {
    color: var(--ink);
    border-bottom: 1px solid var(--hard);
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 11px;
    text-decoration: none;
  }

  .deck-md {
    color: var(--muted);
    border-bottom: 1px solid var(--hard);
    font-size: 13px;
    text-decoration: none;
  }

  .post-back-foot {
    margin-top: var(--space-6);
  }

  /* Table of contents — hanging list behind a thin hairline. Monochrome:
     hierarchy by weight/value, never hue. Depth-3 items indent under their h2. */
  .post-toc {
    margin: var(--space-5) 0 var(--space-6);
    padding: var(--space-3) 0 var(--space-1) var(--space-3);
    border-left: 1px solid var(--hard);
  }

  .post-toc-label {
    margin: 0 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .post-toc-label::-webkit-details-marker { display: none; }
  .post-toc-label::before { content: "▸  "; color: var(--ink); }
  .post-toc[open] > .post-toc-label::before { content: "▾  "; }
  .post-toc:not([open]) > .post-toc-label { margin-bottom: 0; }

  .post-toc ul {
    list-style: none;
    counter-reset: toc;
    margin: 0;
    padding: 0;
  }

  .post-toc li {
    margin: 0 0 var(--space-1);
    line-height: 1.4;
  }

  .post-toc-d2 {
    counter-increment: toc;
    font-weight: 600;
    display: flex;
    gap: 0.55rem;
  }
  .post-toc-d2::before {
    content: counter(toc, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    flex: 0 0 auto;
    padding-top: 0.12em;
  }

  .post-toc-d3 {
    padding-left: var(--space-3);
    font-weight: 400;
    display: flex;
    gap: 0.5rem;
  }
  .post-toc-d3::before {
    content: "–";
    color: var(--muted);
    flex: 0 0 auto;
  }

  .post-toc a {
    font-size: 14px;
    color: var(--ink);
    text-decoration: none;
  }

  .post-toc a:hover,
  .post-toc a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-body {
    font-size: 17px;
    line-height: 1.7;
  }

  .post-body :global(h2) {
    font-size: 24px;
    margin: var(--space-6) 0 var(--space-3);
    letter-spacing: -0.01em;
  }

  .post-body :global(h3) {
    font-size: 20px;
    margin: var(--space-5) 0 var(--space-2);
  }

  .post-body :global(p),
  .post-body :global(ul),
  .post-body :global(ol) {
    margin: 0 0 var(--space-4);
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    padding-left: var(--space-4);
  }

  .post-body :global(a) {
    color: var(--accent-purple);
  }

  .post-body :global(blockquote) {
    margin: 0 0 var(--space-4);
    padding: var(--space-2) var(--space-4);
    border-left: var(--border-hard);
    color: var(--muted);
  }

  .post-body :global(pre),
  .post-body :global(code) {
    font-family: var(--font-mono);
    font-size: 14px;
  }

  .post-body :global(pre) {
    background: var(--ink);
    color: var(--paper);
    padding: var(--space-3);
    overflow-x: auto;
  }

  .post-body :global(img) {
    max-width: 100%;
    height: auto;
  }
</style>
