---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubscribeBlock from '../../components/SubscribeBlock.astro';
import { site } from '../../data/site';
import { publishedPosts, postPath, formatPostDate, isoDate } from '../../utils/blog';

const posts = publishedPosts(await getCollection('blog'));
const title = `Blog — ${site.name}`;
const description = `Writing and notes from ${site.name}.`;
---

<BaseLayout title={title} description={description}>
  <section class="blog-index">
    <header class="blog-head">
      <p class="blog-stamp">Blog</p>
      <h1 class="blog-title">Blog</h1>
      <p class="doc-line">Doc ATL-002 · Rev 2026-07-17 · Posts filed newest first</p>
    </header>

    <p class="blog-ways">
      Read them here or → <a href="/newsletter">subscribe</a> · <a href="/feed.xml">RSS</a>
    </p>

    {
      posts.length === 0 ? (
        <p class="blog-empty">No posts yet — check back soon.</p>
      ) : (
        <ul class="post-list" role="list">
          {posts.map((post) => (
            <li class="post-item">
              <a class="post-link" href={postPath(post)}>
                <h2 class="post-item-title">{post.data.title}</h2>
              </a>
              <time class="post-item-date" datetime={isoDate(post.data.pubDate)}>
                {formatPostDate(post.data.pubDate)}
              </time>
              <p class="post-item-desc">{post.data.description}</p>
            </li>
          ))}
        </ul>
      )
    }
  </section>
  <SubscribeBlock />
</BaseLayout>

<style>
  .blog-index {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    padding: var(--space-6) var(--space-4) var(--space-7);
  }

  .blog-head {
    border-bottom: 2px solid var(--ink);
    padding-bottom: var(--space-3);
  }

  .blog-stamp {
    /* R4 — stamp. */
    font-family: var(--font-data);
    font-size: 12px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--dim);
    margin: 0 0 var(--space-1);
  }

  .blog-title {
    margin: 0 0 var(--space-3);
    font-size: clamp(26px, 5.5vw, 44px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: 0.02em;
  }

  .doc-line {
    margin: 0;
  }

  .blog-ways {
    /* R2 — a prose sentence with two links in it. */
    font-family: var(--font-text);
    font-size: 12px;
    letter-spacing: 0.03em;
    color: var(--dim);
    margin: var(--space-4) 0 0;
  }

  .blog-ways a {
    color: var(--ink);
  }

  .blog-empty {
    /* R2 — empty-state prose. */
    font-family: var(--font-text);
    color: var(--dim);
    margin: var(--space-5) 0 0;
  }

  .post-list {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .post-item {
    padding-bottom: var(--space-5);
    border-bottom: var(--border-hairline);
  }

  .post-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .post-link {
    text-decoration: none;
    display: inline-block;
  }

  .post-item-title {
    margin: 0;
    font-size: clamp(20px, 3vw, 26px);
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .post-link:hover .post-item-title,
  .post-link:focus-visible .post-item-title {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .post-item-date {
    display: block;
    /* R4 — date stamp. */
    font-family: var(--font-data);
    font-size: 12px;
    color: var(--dim);
    margin: var(--space-2) 0;
  }

  .post-item-desc {
    margin: 0;
    color: var(--ink);
  }
</style>
