---
import BaseLayout from '../layouts/BaseLayout.astro';
import LinkTree from '../components/LinkTree.astro';
import { site } from '../data/site';
import { heroSegments } from '../data/hero';

const title = `${site.name} — venture studio`;
---

<BaseLayout title={title} description={site.blurb}>
  <section class="hero" aria-labelledby="hero-blurb">
    <div class="hero-sheet masthead">
      <div class="mast-row" aria-hidden="true">
        <span>Atelier Gökhan Turhan</span>
        <span>Doc ATL-001 · Rev 2026-07-18</span>
        <span>Status: Operating</span>
      </div>
      <p class="mast-raise">
        <span class="raise-flag">We are raising</span>
        <span class="raise-note">— check our decks:</span>
        <a class="raise-link" href="https://ishtar.numetal.xyz/deck/not-raising-a-preseed/"
          >Ishtar deck</a
        >
        <a class="raise-link" href="https://curb.numetal.xyz/deck">Curb deck</a>
      </p>
      <div class="mast-title">
        <h1 id="hero-blurb" class="hero-blurb">
          {
            heroSegments.map((segment) =>
              segment.accent ? (
                <span class={`hero-accent accent-${segment.accent}`}>{segment.text}</span>
              ) : (
                segment.text
              ),
            )
          }
        </h1>
        <p class="hero-stamp-row">
          <span class="stamp">Venture studio — public record</span>
        </p>
      </div>
      <div class="mast-row mast-row--foot" aria-hidden="true">
        <span>Canonical: gokhan.vc</span>
        <span>Contact: contact@gokhan.vc</span>
      </div>
    </div>
  </section>
  <LinkTree />
</BaseLayout>

<style>
  .hero {
    display: flex;
    justify-content: center;
    padding: var(--space-5) var(--space-3);
  }

  .hero-sheet {
    width: 100%;
    max-width: 880px;
  }

  .hero-blurb {
    margin: 0;
    font-size: clamp(17px, 2.4vw, 24px);
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: 0.02em;
    overflow-wrap: break-word;
    hyphens: manual;
  }

  .hero-accent {
    font-weight: inherit;
  }

  .hero-stamp-row {
    margin: var(--space-4) 0 0;
  }

  /* Raise notice — the one inverted bar on the page: ink ground, paper text.
     Inversion is the loudest signal the four tokens allow. */
  .mast-raise {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.8ch;
    margin: 0;
    padding: 0.55rem 0.8rem;
    background: var(--ink);
    color: var(--paper);
    border-bottom: 1px solid var(--ink);
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .raise-flag {
    font-weight: 700;
    letter-spacing: 0.22em;
  }

  .raise-note {
    color: var(--faint);
  }

  .raise-link {
    color: var(--paper);
    border: 1px solid var(--paper);
    padding: 0.15rem 0.6rem;
    text-decoration: none;
    font-weight: 700;
  }

  .raise-link:hover,
  .raise-link:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  @media (max-width: 480px) {
    .hero {
      padding: var(--space-4) var(--space-3);
    }
  }
</style>
