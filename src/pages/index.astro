---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const title = `${site.name} — venture studio`;
---

<BaseLayout title={title} description={site.blurb}>
  <section class="hero">
    <h1 class="hero-blurb">{site.blurb}</h1>
  </section>
</BaseLayout>

<style>
  .hero {
    max-width: 960px;
    margin: 0 auto;
    padding: 64px 24px;
  }
  .hero-blurb {
    margin: 0;
    font-size: clamp(28px, 5vw, 56px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
</style>
