---
import BaseLayout from '../layouts/BaseLayout.astro';
import LinkTree from '../components/LinkTree.astro';
import { site } from '../data/site';

const title = `${site.name} — venture studio`;

// Project index — the stacked table, mirrored from gokhanturhan.com's landing.
// INDEX drops to the studio portfolio below; the rest jump out to live products.
// URLs verified live 2026-07-21.
const projectIndex = [
  { no: '01', name: 'INDEX', note: 'every project, explained', href: '/projects', external: false },
  {
    no: '02',
    name: 'CURB',
    note: 'agent↔agent inference clearing rail',
    href: 'https://curb.numetal.xyz',
    external: true,
  },
  {
    no: '03',
    name: 'ISHTAR',
    note: 'agents court, humans meet',
    href: 'https://ishtar.numetal.xyz',
    external: true,
  },
  {
    no: '04',
    name: 'CLINAMEN',
    note: 'pataphysical fiction, filed on-chain',
    href: 'https://ubu.numetal.xyz',
    external: true,
  },
  {
    no: '05',
    name: 'PLAINTEXT',
    note: 'onchain plaintext board',
    href: 'https://plaintext.numetal.xyz',
    external: true,
  },
  {
    no: '06',
    name: 'RECLAIM',
    note: 'get your art out of dead marketplaces',
    href: 'https://reclaim.numetal.xyz',
    external: true,
  },
];
---

<BaseLayout title={title} description={site.blurb}>
  <section class="hero" aria-labelledby="hero-blurb">
    <div class="hero-sheet masthead">
      <div class="mast-row" aria-hidden="true">
        <span>Gökhan Ventures</span>
        <span>Doc ATL-001 · Rev 2026-07-21</span>
        <span>Status: Operating</span>
      </div>
      <p class="mast-raise">
        <span class="raise-flag">We are raising</span>
        <span class="raise-note">— check our decks:</span>
        <a class="raise-link" href="https://ishtar.numetal.xyz/deck/not-raising-a-preseed/"
          >Ishtar deck</a
        >
        <a class="raise-link" href="https://curb.numetal.xyz/deck">Curb deck</a>
      </p>
      <div class="mast-title">
        <h1 id="hero-blurb" class="hero-title">Gökhan Ventures</h1>
        <p class="hero-sub">Venture studio · agent accelerator · one person, a fleet of agents</p>
        <p class="hero-stamp-row">
          <span class="stamp">Venture studio — public record</span>
        </p>
      </div>
      <div class="mast-row mast-row--foot" aria-hidden="true">
        <span>Canonical: gokhan.vc</span>
        <span>Contact: contact@gokhan.vc</span>
      </div>
    </div>
  </section>

  <section class="pindex-band" aria-label="Project index">
    <div class="pindex-wrap">
      <p class="doc-heading">
        <span>Project index</span><span class="section-no" aria-hidden="true">§0</span>
      </p>
      <nav class="pindex">
        {
          projectIndex.map((it) => (
            <a
              class="pirow"
              href={it.href}
              target={it.external ? '_blank' : undefined}
              rel={it.external ? 'noopener noreferrer' : undefined}
            >
              <span class="pi-no">{it.no}</span>
              <span class="pi-name">{it.name}</span>
              <span class="pi-note">{it.note}</span>
              <span class="pi-arrow" aria-hidden="true">
                {it.external ? '↗' : '→'}
              </span>
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <LinkTree />
  <aside class="raise-echo" aria-label="Fundraise notice">
    <p class="mast-raise mast-raise--echo">
      <span class="raise-flag">We are raising</span>
      <span class="raise-note">— check our decks:</span>
      <a class="raise-link" href="https://ishtar.numetal.xyz/deck/not-raising-a-preseed/"
        >Ishtar deck</a
      >
      <a class="raise-link" href="https://curb.numetal.xyz/deck">Curb deck</a>
    </p>
  </aside>
</BaseLayout>

<style>
  .hero {
    display: flex;
    justify-content: center;
    padding: var(--space-5) var(--space-3) var(--space-4);
  }

  .hero-sheet {
    width: 100%;
    max-width: 880px;
  }

  .hero-title {
    margin: 0;
    font-size: clamp(26px, 5.5vw, 44px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: 0.02em;
  }

  .hero-sub {
    /* R4 — uppercase letterspaced subtitle rule. */
    font-family: var(--font-data);
    margin: 0.6rem 0 0;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .hero-stamp-row {
    margin: var(--space-4) 0 0;
  }

  /* Project index — stacked ledger table, same read as the register box. */
  .pindex-band {
    display: flex;
    justify-content: center;
    padding: 0 var(--space-3) var(--space-6);
  }

  .pindex-wrap {
    width: 100%;
    max-width: 880px;
  }

  .pindex {
    border: 2px solid var(--ink);
    margin-top: 2px;
  }

  .pirow {
    display: grid;
    grid-template-columns: 3rem minmax(8rem, max-content) 1fr 1.4rem;
    gap: var(--space-3);
    align-items: baseline;
    padding: 0.72rem 0.9rem;
    border-bottom: 1px solid var(--ink);
    color: var(--ink);
    text-decoration: none;
  }

  .pirow:last-child {
    border-bottom: 0;
  }

  .pirow:hover {
    background: var(--faint);
  }

  .pirow:hover .pi-name {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .pi-no {
    /* R4 — index number. */
    font-family: var(--font-data);
    font-size: 11px;
    color: var(--dim);
    letter-spacing: 0.06em;
  }

  .pi-name {
    /* R4 — product identifier. */
    font-family: var(--font-data);
    font-weight: 700;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .pi-note {
    font-size: 13px;
    color: var(--dim);
  }

  .pi-arrow {
    text-align: right;
    color: var(--dim);
    font-size: 13px;
  }

  /* Raise notice — the one inverted bar on the page: ink ground, paper text.
     Inversion is the loudest signal the four tokens allow. */
  .mast-raise {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.8ch;
    margin: 0;
    padding: 0.55rem 0.8rem;
    background: var(--ink);
    color: var(--paper);
    border-bottom: 1px solid var(--ink);
    /* R4 — the inverted notice bar. */
    font-family: var(--font-data);
    font-size: 14px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  /* Closing echo of the raise bar — full-bleed band above the footer
     perforation; the document signs off the way it opened. */
  .mast-raise--echo {
    border-bottom: 0;
    border-top: 2px solid var(--ink);
    padding: 0.7rem 0.8rem;
  }

  .raise-flag {
    font-weight: 700;
    letter-spacing: 0.22em;
  }

  .raise-note {
    color: var(--faint);
  }

  .raise-link {
    color: var(--paper);
    border: 1px solid var(--paper);
    padding: 0.15rem 0.6rem;
    text-decoration: none;
    font-weight: 700;
  }

  .raise-link:hover,
  .raise-link:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  @media (max-width: 640px) {
    .pirow {
      grid-template-columns: 2.4rem 1fr auto;
      gap: var(--space-2);
    }

    .pi-note {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .hero {
      padding: var(--space-4) var(--space-3);
    }
  }
</style>
