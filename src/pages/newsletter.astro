---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const title = `Newsletter — ${site.name}`;
const description = 'Subscribe to the Numetal / Ishtar / CURB / studio estate newsletter. One list, signal only.';
const subscribeAction = 'https://api.gokhan.vc/newsletter/subscribe';
---

<BaseLayout title={title} description={description}>
  <section class="nl">
    <div class="nl-sheet masthead">
      <div class="mast-row" aria-hidden="true">
        <span>Gökhan Ventures</span>
        <span>Doc ATL-012 · Rev 2026-07-18</span>
        <span>Status: Open list</span>
      </div>
      <div class="mast-title">
        <h1 class="nl-title">Newsletter</h1>
        <p class="nl-sub">One estate list across Numetal / Ishtar / CURB / the studio. Signal only. Double opt-in.</p>
        <p class="nl-stamp-row"><span class="stamp">Estate list — open</span></p>
      </div>
      <div class="mast-row mast-row--foot" aria-hidden="true">
        <span>Canonical: gokhan.vc/newsletter</span>
        <span>Contact: {site.contactEmail}</span>
      </div>
    </div>

    <form class="nl-form" method="POST" action={subscribeAction}>
      <input type="hidden" name="site" value="atelier" />
      <label class="nl-label" for="email">Email</label>
      <input
        id="email"
        name="email"
        type="email"
        required
        placeholder="you@example.com"
        autocomplete="email"
        class="nl-input"
      />
      <button type="submit" class="nl-btn" title="Subscribe via api.gokhan.vc (site=atelier)">Subscribe</button>
    </form>

    <p class="nl-more">
      Latest: <a href="/blog/x402-economy-july-2026">The x402 economy — July 2026</a> · <a href="/blog">All posts</a>.
      Public contact: <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .nl {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    padding: var(--space-6) var(--space-4) var(--space-7);
  }

  .nl-sheet {
    width: 100%;
  }

  .nl-title {
    margin: 0;
    font-size: clamp(26px, 5.5vw, 44px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: 0.02em;
  }

  .nl-sub {
    margin: var(--space-3) 0 0;
    color: var(--ink);
    max-width: 60ch;
  }

  .nl-stamp-row {
    margin: var(--space-4) 0 0;
  }

  .nl-form {
    margin: var(--space-5) 0 0;
    max-width: 520px;
    border: var(--border-hard);
    padding: var(--space-4);
  }

  .nl-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
    margin: 0 0 var(--space-2);
  }

  .nl-input {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--ink);
    background: transparent;
    color: var(--ink);
    font: inherit;
    margin-bottom: var(--space-3);
  }

  .nl-input::placeholder {
    color: var(--dim);
  }

  .nl-input:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  .nl-btn {
    padding: 10px 20px;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .nl-btn:hover,
  .nl-btn:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .nl-more {
    margin: var(--space-5) 0 0;
    color: var(--dim);
    max-width: 60ch;
    line-height: 1.55;
  }

  .nl-more a {
    color: var(--ink);
  }
</style>
