---
import BaseLayout from '../layouts/BaseLayout.astro';
import { studioProjects, projectCategories, projectStatuses } from '../data/projects';

const title = 'Projects — Gökhan Ventures';
const description =
  'Every venture and build in the studio, explained — Ishtar, CURB, Launch, HeartBench, HeartPrefs, Numetal, CLINAMEN/$UBU, Plaintext, Reclaim, and more. Filter by category or status.';
---

<BaseLayout title={title} description={description}>
  <section class="projects">
    <header class="proj-head">
      <p class="doc-line">Gökhan Ventures · project register</p>
      <h1 class="proj-title">Projects</h1>
      <p class="proj-lead">
        Every venture and build in the studio, with what each one actually does. Filter by category
        or status; each card links out to the live project.
      </p>
    </header>

    <div class="proj-filters" role="group" aria-label="Filter projects">
      <div class="filter-group">
        <span class="filter-label">Category</span>
        <div class="chips" data-filter="category">
          <button type="button" class="chip is-active" data-value="all" aria-pressed="true"
            >All</button
          >
          {
            projectCategories.map((c) => (
              <button type="button" class="chip" data-value={c} aria-pressed="false">
                {c}
              </button>
            ))
          }
        </div>
      </div>
      <div class="filter-group">
        <span class="filter-label">Status</span>
        <div class="chips" data-filter="status">
          <button type="button" class="chip is-active" data-value="all" aria-pressed="true"
            >All</button
          >
          {
            projectStatuses.map((s) => (
              <button type="button" class="chip" data-value={s} aria-pressed="false">
                {s}
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <p class="proj-count">
      Showing <span id="proj-count">{studioProjects.length}</span> of {studioProjects.length} projects
    </p>

    <div class="preg">
      {
        studioProjects.map((p, i) => (
          <a
            class="pcell proj-row"
            href={p.href}
            target="_blank"
            rel="noopener noreferrer"
            data-category={p.category}
            data-status={p.status}
          >
            <div class="pcell-meta">
              <span class="pcell-no">{String(i + 1).padStart(2, '0')}</span>
              <span class="pcell-domain">{p.domain}</span>
              <span class="pcell-arrow" aria-hidden="true">
                ↗
              </span>
            </div>
            <div class="pcell-name">{p.name}</div>
            <div class="pcell-tags">
              <span class="tag">{p.category}</span>
              <span class="tag">{p.status}</span>
            </div>
            <p class="pcell-blurb">{p.blurb}</p>
          </a>
        ))
      }
    </div>

    <p class="proj-empty" id="proj-empty" hidden>No projects match those filters.</p>
  </section>

  <script is:inline src="/projects-filter.js" defer></script>

  <style>
    .projects {
      max-width: 1040px;
      margin: 0 auto;
      padding: var(--space-6) var(--space-3) var(--space-7);
    }

    .proj-head {
      max-width: 70ch;
    }

    .doc-line {
      /* R4 — filing reference. */
      font-family: var(--font-data);
      font-size: 10.5px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--dim);
      margin: 0;
    }

    .proj-title {
      margin: var(--space-2) 0 0;
      font-size: clamp(28px, 5vw, 44px);
      font-weight: 700;
      letter-spacing: 0.02em;
      line-height: 1.05;
    }

    .proj-lead {
      margin: var(--space-3) 0 0;
      font-size: 15px;
      line-height: 1.6;
      color: var(--dim);
      max-width: 62ch;
    }

    /* Filter bar — ruled band of single-select chip groups. */
    .proj-filters {
      margin-top: var(--space-5);
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3) var(--space-5);
      border-top: 2px solid var(--ink);
      border-bottom: 2px solid var(--ink);
      padding: var(--space-3) 0;
    }

    .filter-group {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: var(--space-2);
    }

    .filter-label {
      /* R4 — control-group label. */
      font-family: var(--font-data);
      font-size: 10.5px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--dim);
      margin-right: var(--space-1);
    }

    .chips {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }

    .chip {
      font: inherit;
      /* R4 — control label. Follows `font: inherit`; the shorthand resets family. */
      font-family: var(--font-data);
      font-size: 12px;
      letter-spacing: 0.03em;
      border: 1px solid var(--ink);
      background: var(--paper);
      color: var(--ink);
      padding: 0.35rem 0.7rem;
      cursor: pointer;
    }

    .chip:hover {
      background: var(--faint);
    }

    .chip.is-active {
      background: var(--ink);
      color: var(--paper);
      font-weight: 700;
    }

    .chip:focus-visible {
      outline: 2px solid var(--ink);
      outline-offset: 2px;
    }

    .proj-count {
      margin: var(--space-3) 0 var(--space-2);
      /* R4 — microlabel. The count inside it needs no tabular-nums: the data
         face is already tabular, so the declaration would be noise. */
      font-family: var(--font-data);
      font-size: 11px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--dim);
    }

    /* Project register — fully-boxed ledger grid of cards (2px outer frame,
       1px cells), each card a link out. Same read as gokhanturhan.com. */
    .preg {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      border: 2px solid var(--ink);
      margin-top: 2px;
    }

    .pcell {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      min-height: 8.5rem;
      padding: var(--space-3);
      border: 1px solid var(--ink);
      background: var(--paper);
      color: var(--ink);
      text-decoration: none;
    }

    .pcell:hover,
    .pcell:focus-visible {
      background: var(--faint);
    }

    .pcell:hover .pcell-name,
    .pcell:focus-visible .pcell-name {
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    .pcell[hidden] {
      display: none;
    }

    .pcell-meta {
      display: flex;
      align-items: baseline;
      gap: var(--space-2);
      /* R4/R5 — cell number and hostname. */
      font-family: var(--font-data);
      font-size: 10px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--dim);
    }

    .pcell-no {
      font-weight: 700;
      color: var(--ink);
    }

    .pcell-domain {
      overflow-wrap: anywhere;
    }

    .pcell-arrow {
      margin-left: auto;
      color: var(--dim);
    }

    .pcell-name {
      font-size: 18px;
      font-weight: 700;
      letter-spacing: 0.01em;
      line-height: 1.15;
    }

    .pcell-tags {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }

    .tag {
      /* R4 — pill. */
      font-family: var(--font-data);
      font-size: 10px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      border: 1px solid var(--ink);
      padding: 0.15rem 0.45rem;
      white-space: nowrap;
    }

    .pcell-blurb {
      margin: 0;
      font-size: 13px;
      line-height: 1.5;
      color: var(--dim);
    }

    .proj-empty {
      margin-top: var(--space-4);
      font-size: 14px;
      color: var(--dim);
    }
  </style>
</BaseLayout>
